<nav class="tsd-navigation">
    <div class="tsd-accordion-details">
        <ul>
            {{#each navigation.children}}
                {{> navigation}}
            {{/each}}
        </ul>
    </div>
</nav>

<div class="tsd-accordion-details">
    <ul class="tsd-nested-navigation">
        {{#each settings.links}}
            <li class="{{cssClasses}}">
                <a href="{{url}}" class="tsd-index-link">
                    {{label}}
                </a>
            </li>
        {{/each}}
    </ul>
</div> 