{
  "name": "@hop-protocol/v2-sdk",
  "version": "0.0.1-beta.21",
  "description": "The Hop Protocol v2 JavaScript SDK",
  "author": "Authereum Labs, Inc.",
  "license": "MIT",
  "homepage": "https://hop.exchange",
  "repository": {
    "type": "git",
    "url": "git://github.com/hop-protocol/hop.git",
    "directory": "packages/v2-sdk"
  },
  "files": [
    "dist"
  ],
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "scripts": {
    "clean": "rm -rf node_modules dist ./tsconfig.tsbuildinfo ./addresses ./config ./metadata ./networks",
    "test": "pnpm build:esm && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "dev": "pnpm version && tsc --watch",
    "build": "pnpm version && pnpm build:all",
    "build:ts": "tsc",
    "build:esm": "tsc -p ./tsconfig.esm.json && echo '{\"type\": \"module\", \"imports\": { \"#*\": \"./*\" }}' > dist/esm/package.json",
    "build:cjs": "tsc -p ./tsconfig.cjs.json && echo '{\"type\": \"commonjs\", \"imports\": { \"#*\": \"./*\" }}' > dist/cjs/package.json",
    "build:all": "pnpm build:cjs && pnpm build:esm",
    "build:toplevel": "bash -c 'cp -r ./dist/cjs/{addresses,config,metadata,networks} ./'",
    "clean:docs": "rm -rf docs",
    "clean:docs-ui": "rm -rf docs-ui",
    "lint": "eslint . --config ./eslint.config.mjs --fix",
    "version": "echo \"export default '$(cat package.json | jq -r '.version')'\" > src/version.ts",
    "bump": "pnpm version prerelease --preid=beta",
    "release": "pnpm build && pnpm lint && pnpm test && pnpm bump",
    "bump-release": "pnpm bump && pnpm release",
    "docs:markdown": "typedoc --plugin typedoc-plugin-markdown --theme markdown --hideGenerator --excludeExternals --excludePrivate --disableSources --hideBreadcrumbs --namedAnchors --out docs src/index.ts",
    "docs:concat": "typedoc --plugin typedoc-plugin-markdown --theme markdown --hideGenerator --excludeExternals --excludePrivate --disableSources --hideBreadcrumbs --namedAnchors --out docs src/index.ts && pnpm dlx concat-md --toc --decrease-title-levels --dir-name-as-title docs > docs/README.md",
    "docs:ui": "typedoc --out docs-ui src/index.ts",
    "docs": "pnpm docs:ui && pnpm docs:markdown"
  },
  "dependencies": {
    "@hop-protocol/sdk-core": "workspace:*",
    "buffer": "6.0.3",
    "dotenv": "16.4.1",
    "esbuild": "0.20.0",
    "ethereum-block-by-date": "1.4.9",
    "ethers": "5.7.2",
    "eventemitter3": "5.0.1",
    "fast-memoize": "2.5.2",
    "luxon": "3.4.4",
    "merkletreejs": "0.3.11",
    "@arbitrum/sdk": "2.0.18",
    "@eth-optimism/contracts": "0.5.3",
    "@eth-optimism/message-relayer": "0.2.18",
    "@eth-optimism/sdk": "3.1.4",
    "@fxportal/maticjs-fxportal": "1.1.1",
    "@maticnetwork/maticjs": "3.2.0",
    "@maticnetwork/maticjs-ethers": "1.0.2",
    "isomorphic-fetch": "3.0.0",
    "lodash": "4.17.21",
    "wait": "0.4.2",
    "web3-utils": "1.7.5"
  },
  "devDependencies": {
    "@types/luxon": "3.4.2",
    "@types/isomorphic-fetch": "0.0.35",
    "@types/jest": "27.0.3",
    "@types/lodash": "4.14.190",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "typedoc": "0.25.7",
    "typedoc-plugin-markdown": "3.17.1"
  },
  "peerDependencies": {
    "ethers": "^5"
  },
  "imports": {
    "#*": {
      "import": "./dist/esm/*",
      "require": "./dist/cjs/*"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/esm/config/index.d.ts",
        "default": "./dist/esm/config/index.js"
      },
      "require": {
        "types": "./dist/cjs/config/index.d.ts",
        "default": "./dist/cjs/config/index.js"
      }
    },
    "./addresses": {
      "import": {
        "types": "./dist/esm/addresses/index.d.ts",
        "default": "./dist/esm/addresses/index.js"
      },
      "require": {
        "types": "./dist/cjs/addresses/index.d.ts",
        "default": "./dist/cjs/addresses/index.js"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/esm/contracts/index.d.ts",
        "default": "./dist/esm/contracts/index.js"
      },
      "require": {
        "types": "./dist/cjs/contracts/index.d.ts",
        "default": "./dist/cjs/contracts/index.js"
      }
    },
    "./common": {
      "import": {
        "types": "./dist/esm/common/index.d.ts",
        "default": "./dist/esm/common/index.js"
      },
      "require": {
        "types": "./dist/cjs/common/index.d.ts",
        "default": "./dist/cjs/common/index.js"
      }
    },
    "./networks_": {
      "import": {
        "types": "./dist/esm/networks_/index.d.ts",
        "default": "./dist/esm/networks_/index.js"
      },
      "require": {
        "types": "./dist/cjs/networks_/index.d.ts",
        "default": "./dist/cjs/networks_/index.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/esm/events/index.d.ts",
        "default": "./dist/esm/events/index.js"
      },
      "require": {
        "types": "./dist/cjs/events/index.d.ts",
        "default": "./dist/cjs/events/index.js"
      }
    },
    "./messenger": {
      "import": {
        "types": "./dist/esm/messenger/index.d.ts",
        "default": "./dist/esm/messenger/index.js"
      },
      "require": {
        "types": "./dist/cjs/messenger/index.d.ts",
        "default": "./dist/cjs/messenger/index.js"
      }
    },
    "./hubConnector": {
      "import": {
        "types": "./dist/esm/hubConnector/index.d.ts",
        "default": "./dist/esm/hubConnector/index.js"
      },
      "require": {
        "types": "./dist/cjs/hubConnector/index.d.ts",
        "default": "./dist/cjs/hubConnector/index.js"
      }
    },
    "./railsHub": {
      "import": {
        "types": "./dist/esm/railsHub/index.d.ts",
        "default": "./dist/esm/railsHub/index.js"
      },
      "require": {
        "types": "./dist/cjs/railsHub/index.d.ts",
        "default": "./dist/cjs/railsHub/index.js"
      }
    },
    "./nft": {
      "import": {
        "types": "./dist/esm/common/index.d.ts",
        "default": "./dist/esm/common/index.js"
      },
      "require": {
        "types": "./dist/cjs/common/index.d.ts",
        "default": "./dist/cjs/common/index.js"
      }
    },
    "./gasPriceOracle": {
      "import": {
        "types": "./dist/esm/gasPriceOracle/index.d.ts",
        "default": "./dist/esm/gasPriceOracle/index.js"
      },
      "require": {
        "types": "./dist/cjs/gasPriceOracle/index.d.ts",
        "default": "./dist/cjs/gasPriceOracle/index.js"
      }
    },
    "./exitRelayers": {
      "import": {
        "types": "./dist/esm/exitRelayers/index.d.ts",
        "default": "./dist/esm/exitRelayers/index.js"
      },
      "require": {
        "types": "./dist/cjs/exitRelayers/index.d.ts",
        "default": "./dist/cjs/exitRelayers/index.js"
      }
    }
  }
}
